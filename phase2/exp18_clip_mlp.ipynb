   "source": [
    "import pkg_resources, packaging\n",
    "pkg_resources.packaging = packaging\n",
    "\n",
    "import os\n",
    "import clip\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import wandb\n",
    "import matplotlib.pyplot as plt\n",
    "from pathlib import Path\n",
    "from PIL import Image\n",
    "from tqdm.auto import tqdm\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score, classification_report,\n",
    "    confusion_matrix, ConfusionMatrixDisplay,\n",
    ")\n",
    "from torch.utils.data import DataLoader, TensorDataset\n",
    "\n",
    "PROJECT    = Path(\".\").resolve().parent\n",
    "MANIFEST   = PROJECT / \"data\" / \"frames\" / \"manifest.csv\"\n",
    "CACHE_PATH = PROJECT / \"data\" / \"frames\" / \"clip_features.npz\"\n",
    "CKPT_PATH  = PROJECT / \"data\" / \"frames\" / \"clip_mlp_best.pt\"\n",
    "\n",
    "EPOCHS     = 50\n",
    "BATCH_SIZE = 64\n",
    "LR         = 1e-3\n",
    "DROPOUT    = 0.3\n",
    "SEED       = 42\n",
    "\n",
    "torch.manual_seed(SEED)\n",
    "device = (\n",
    "    \"mps\"  if torch.backends.mps.is_available() else\n",
    "    \"cuda\" if torch.cuda.is_available()         else\n",
    "    \"cpu\"\n",
    ")\n",
    "print(f\"Device: {device}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1 — Load manifest"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "8658 frames\n",
      "label\n",
      "hidden     4882\n",
      "visible    3776\n"
     ]
    }
   ],
   "source": [
    "df = pd.read_csv(MANIFEST)\n",
    "df[\"abs_path\"] = df[\"path\"].apply(lambda p: PROJECT / p)\n",
    "df = df[df[\"abs_path\"].apply(lambda p: p.exists())].reset_index(drop=True)\n",
    "\n",
    "label_map = {\"visible\": 1, \"hidden\": 0}\n",
    "df[\"y\"] = df[\"label\"].map(label_map)\n",
    "\n",
    "print(f\"{len(df)} frames\")\n",
    "print(df[\"label\"].value_counts().to_string())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2 — Extract CLIP features (cached after first run)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "CLIP ViT-B/32 loaded — feature dim: 512\n"
     ]
    }
   ],
   "source": [
    "clip_model, preprocess = clip.load(\"ViT-B/32\", device=device)\n",
    "clip_model.eval()\n",
    "print(\"CLIP ViT-B/32 loaded — feature dim: 512\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Manifest changed — re-extracting ...\n"
     ]
    },
    {
     "data": {
      "application/vnd.jupyter.widget-view+json": {
       "model_id": "fac186dda3054592b4ccdde2b13ed63c",
       "version_major": 2,
       "version_minor": 0
      },
      "text/plain": [
       "CLIP encode:   0%|          | 0/136 [00:00<?, ?it/s]"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Feature matrix: (8658, 512)  (n_frames × clip_dim)\n"
     ]
    }
   ],
   "source": [
    "def extract_features(paths):\n",
    "    feats = []\n",
    "    for i in tqdm(range(0, len(paths), BATCH_SIZE), desc=\"CLIP encode\"):\n",
    "        batch_paths = paths[i : i + BATCH_SIZE]\n",
    "        imgs = []\n",
    "        for p in batch_paths:\n",
    "            try:\n",
    "                imgs.append(preprocess(Image.open(p).convert(\"RGB\")))\n",
    "            except Exception:\n",
    "                imgs.append(torch.zeros(3, 224, 224))\n",
    "        batch = torch.stack(imgs).to(device)\n",
    "        with torch.no_grad():\n",
    "            f = clip_model.encode_image(batch).float()\n",
    "            f = f / f.norm(dim=-1, keepdim=True)\n",
    "        feats.append(f.cpu().numpy())\n",
    "    return np.vstack(feats)\n",
    "\n",
    "\n",
    "current_paths = [str(p) for p in df[\"abs_path\"]]\n",
    "\n",
    "if CACHE_PATH.exists():\n",
    "    cache = np.load(CACHE_PATH, allow_pickle=True)\n",
    "    if list(cache[\"paths\"]) == current_paths:\n",
    "        features = cache[\"features\"]\n",
    "        print(f\"Cache hit — {len(features)} features loaded\")\n",
    "    else:\n",
    "        print(\"Manifest changed — re-extracting ...\")\n",
    "        features = extract_features(df[\"abs_path\"].tolist())\n",
    "        np.savez(CACHE_PATH, features=features, paths=current_paths)\n",
    "else:\n",
    "    features = extract_features(df[\"abs_path\"].tolist())\n",
    "    np.savez(CACHE_PATH, features=features, paths=current_paths)\n",
    "    print(f\"Features cached → {CACHE_PATH}\")\n",
    "\n",
    "print(f\"Feature matrix: {features.shape}  (n_frames × clip_dim)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3 — Train / test split (80 / 20, stratified)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Train: 6926  |  Test: 1732\n",
      "Train — visible: 3021  hidden: 3905\n",
      "Class weights → hidden: 0.89  visible: 1.15\n"
     ]
    }
   ],
   "source": [
    "X = features.astype(np.float32)\n",
    "y = df[\"y\"].values.astype(np.int64)\n",
    "\n",
    "X_train, X_test, y_train, y_test, idx_train, idx_test = train_test_split(\n",
    "    X, y, np.arange(len(df)),\n",
    "    test_size=0.2, random_state=SEED, stratify=y,\n",
    ")\n",
    "\n",
    "n_vis = y_train.sum()\n",
    "n_hid = (y_train == 0).sum()\n",
    "class_weights = torch.tensor(\n",
    "    [len(y_train) / (2 * n_hid), len(y_train) / (2 * n_vis)],\n",
    "    dtype=torch.float32\n",
    ").to(device)\n",
    "\n",
    "print(f\"Train: {len(X_train)}  |  Test: {len(X_test)}\")\n",
    "print(f\"Train — visible: {n_vis}  hidden: {n_hid}\")\n",
    "print(f\"Class weights → hidden: {class_weights[0]:.2f}  visible: {class_weights[1]:.2f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [],
   "source": [
    "train_ds = TensorDataset(torch.from_numpy(X_train), torch.from_numpy(y_train))\n",
    "test_ds  = TensorDataset(torch.from_numpy(X_test),  torch.from_numpy(y_test))\n",
    "\n",
    "train_dl = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True,  drop_last=False)\n",
    "test_dl  = DataLoader(test_ds,  batch_size=BATCH_SIZE, shuffle=False, drop_last=False)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4 — Define model: MLP on top of frozen CLIP"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Model: MLP(512 → 256 → 64 → 2)  params: 147,906\n"
     ]
    }
   ],
   "source": [
    "feat_dim = X.shape[1]  # 512 for ViT-B/32\n",
    "\n",
    "classifier = nn.Sequential(\n",
    "    nn.Linear(feat_dim, 256),\n",
    "    nn.ReLU(),\n",
    "    nn.Dropout(DROPOUT),\n",
    "    nn.Linear(256, 64),\n",
    "    nn.ReLU(),\n",
    "    nn.Dropout(DROPOUT),\n",
    "    nn.Linear(64, 2),\n",
    ").to(device)\n",
    "\n",
    "criterion = nn.CrossEntropyLoss(weight=class_weights)\n",
    "optimizer = torch.optim.Adam(classifier.parameters(), lr=LR, weight_decay=1e-4)\n",
    "scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=EPOCHS)\n",
    "\n",
    "total_params = sum(p.numel() for p in classifier.parameters())\n",
    "print(f\"Model: MLP({feat_dim} → 256 → 64 → 2)  params: {total_params:,}\")"
   ]
  },
  {
