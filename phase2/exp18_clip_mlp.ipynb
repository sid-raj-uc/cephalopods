    "    name=\"clip-mlp\",\n",
    "    config={\n",
    "        \"model\":      \"CLIP ViT-B/32 + MLP\",\n",
    "        \"epochs\":     EPOCHS,\n",
    "        \"batch_size\": BATCH_SIZE,\n",
    "        \"lr\":         LR,\n",
    "        \"dropout\":    DROPOUT,\n",
    "        \"optimizer\":  \"Adam\",\n",
    "        \"scheduler\":  \"CosineAnnealingLR\",\n",
    "        \"feat_dim\":   feat_dim,\n",
    "        \"train_size\": len(X_train),\n",
    "        \"test_size\":  len(X_test),\n",
