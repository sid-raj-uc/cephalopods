   "source": [
    "wandb.init(\n",
    "    project=\"nity-octopus-detector\",\n",
    "    name=\"clip-linear-probe\",\n",
    "    config={\n",
    "        \"model\":      \"CLIP ViT-B/32 + Linear\",\n",
    "        \"epochs\":     EPOCHS,\n",
