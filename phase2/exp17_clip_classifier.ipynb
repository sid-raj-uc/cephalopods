    "## 8 — Evaluate best checkpoint"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 47,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Test accuracy: 88.8%\n",
      "\n",
      "              precision    recall  f1-score   support\n",
